{
  "name": "echo-ai-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only local AI conversation history for Codex, Gemini CLI and Claude Code",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "start:background": "bash scripts/echo.sh start --open",
    "stop": "bash scripts/echo.sh stop",
    "status": "bash scripts/echo.sh status",
    "app:macos": "bash scripts/create-macos-app.sh",
    "test:launcher": "node --test tests/launcher.test.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.0"
  }
}
